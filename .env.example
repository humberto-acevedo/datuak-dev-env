# AWS Configuration
AWS_ACCOUNT=123456789012
AWS_PROFILE=default
AWS_REGION=us-east-1

# Claude Environment: development (default, Global endpoints) or production (Bedrock endpoints)
# CLAUDE_ENVIRONMENT=development

# Kiro CLI
KIRO_API_KEY=your-kiro-api-key-here

# AGY/Gemini Configuration
GEMINI_SECRET_NAME=GoogleGeminiAPIKeyiMac
MCP_AWS_ENDPOINT=https://aws-mcp.us-east-1.api.aws/mcp

# Git Configuration (optional, defaults in entrypoint.sh)
GIT_USER_EMAIL=your-email@example.com
GIT_USER_NAME=Your Name

# Workspace Paths (optional)
# IDEAS_DIR=$(HOME)/Documents/Ideas
# TOOLS_CODE_DIR=$(HOME)/Development/tools-code

# Bedrock Inference Profiles (for CLAUDE_ENVIRONMENT=production)
# These are automatically set in Dockerfile but can be overridden:
# ANTHROPIC_BEDROCK_HAIKU=arn:aws:bedrock:us-east-1::inference-profile/US Anthropic Claude Haiku 4.5
# ANTHROPIC_BEDROCK_SONNET=arn:aws:bedrock:us-east-1::inference-profile/US Anthropic Claude Sonnet 4.5
# ANTHROPIC_BEDROCK_OPUS=arn:aws:bedrock:us-east-1::inference-profile/US Anthropic Claude Opus 5
# ANTHROPIC_BEDROCK_FABLE=arn:aws:bedrock:us-east-1::inference-profile/US Anthropic Claude Fable 5.1
