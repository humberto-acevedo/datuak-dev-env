################################################################################
# .env.example — LOCAL DEVELOPMENT ONLY (never commit secrets here)
################################################################################
#
# This file is for LOCAL testing only. All PERMANENT credentials must be stored
# in AWS Secrets Manager. Temporary AWS credentials are provided via aws sso login
# and are injected into containers at runtime via `aws configure export-credentials`.
#
################################################################################

# AWS Configuration
AWS_ACCOUNT=539247495490
AWS_PROFILE=AdministratorAccess-539247495490
AWS_REGION=us-east-1

# Anthropic Workload Identity Federation (WIF) — no API key needed
AWS_ROLE_ARN=arn:aws:iam::539247495490:role/anthropic-workload-identity
# See: docs/ANTHROPIC_WIF_SETUP.md

# 🚫 DO NOT STORE THESE HERE — Use AWS Secrets Manager or secure storage:
#
# KIRO_API_KEY=...
#    → Create secret: aws secretsmanager create-secret --name kiro-api-key --secret-string '...'
#
# GH_TOKEN=ghp_...
#    → Use: gh auth login (stores in Keychain on macOS, secure storage on Linux)

# Git Configuration (optional, defaults in entrypoint.sh)
GIT_USER_EMAIL=your-email@example.com
GIT_USER_NAME=Your Name

# Workspace Paths (optional, conditionally mounted)
# IDEAS_DIR=$(HOME)/Documents/Ideas
# TOOLS_CODE_DIR=$(HOME)/Development/tools-code

# MCP Configuration (already in Dockerfile)
MCP_AWS_ENDPOINT=https://aws-mcp.us-east-1.api.aws/mcp
MCP_AWS_VERSION=1.6.3

# Bedrock Inference Profiles (auto-set in Dockerfile, override only if needed)
# ANTHROPIC_MODEL=us.anthropic.claude-haiku-5-5
# ANTHROPIC_SMALL_FAST_MODEL=us.anthropic.claude-sonnet-5-5
# ANTHROPIC_LARGE_MODEL=us.anthropic.claude-opus-5-5
# ANTHROPIC_ULTRA_FAST_MODEL=us.anthropic.claude-haiku-5-5

# Context Persistence (auto-mounted from host via Makefile)
# ~/.claude/          → Claude Code sessions, settings, skills, memory
# ~/.gemini/          → Gemini/AGY config
# ~/.ssh/             → SSH keys (read-only)
# ~/.config/gh/       → GitHub CLI config (read-only)
# /workspace          → Your code

# Setup Checklist:
#
# 1. Deploy WIF infrastructure (one-time):
#    make wif-deploy
#
# 2. AWS SSO Login:
#    make sso-login
#    (or: aws sso login --profile $(AWS_PROFILE))
#
# 3. Sync context from S3 (daily):
#    make sync-from-s3
#
# 4. Launch container:
#    make claude
#
# NOTE: Every ~12 hours, AWS session expires and you must run `make sso-login` again.
#       Anthropic uses WIF (no API key storage) — automatic token exchange via AWS STS.
